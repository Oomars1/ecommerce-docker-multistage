# Copia este archivo a .env y reemplaza los valores. NUNCA subas .env al repositorio.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=change_me_user_password

# ---------- Laravel (backend) ----------
APP_NAME=EcommerceAPI
# Genera con: docker run --rm php:8.2-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8000
# Genera con: openssl rand -base64 64
JWT_SECRET=
# Clave secreta de Stripe en modo prueba (empieza con sk_test_)
STRIPE_SECRET=your_stripe_secret_key_here
# Ejecutar migraciones / seeders al arrancar el contenedor
RUN_MIGRATIONS=true
RUN_SEEDERS=false
# Regenerar Swagger al arrancar (requiere l5-swagger instalado)
RUN_SWAGGER_GENERATE=false

# ---------- Frontend (Next.js) ----------
# URL de la API vista desde el contenedor del frontend (nombre del servicio en la red de Docker).
# Ajusta el nombre de la variable en docker-compose.yml si tu código usa otro (p. ej. API_URL).
FRONTEND_API_URL=http://api/api

# ---------- Puertos publicados en el host ----------
API_PORT=8000
FRONTEND_PORT=3000
